# ── Gateway (server-side) config ─────────────────────────────────────────────
# Copy to `.env`. These are SERVER-side only — never bundled into the browser.
# The Facilio API key lives HERE now, not in the frontend.

# Port the gateway listens on
PORT=8787

# Browser origin(s) allowed to call this gateway (comma-separated, scheme+host,
# NO trailing slash). Any localhost port is allowed automatically, so this only
# matters for deployed origins — and EVERY deployed origin must be listed, not
# just the default one: an unlisted origin gets the first entry echoed back in
# Access-Control-Allow-Origin, which the browser rejects as a CORS error.
# The Vite dev server default is http://localhost:5173.
#
# Deployed (Lambda Function URL) — the portal is served from BOTH of these:
#   CORS_ORIGIN=https://alrayan-inquiryportal.faciliointegrations.com,https://main.d2r2c8qc694xdc.amplifyapp.com
CORS_ORIGIN=http://localhost:5173

# Facilio app base URL (everything before /api/v3/...)
FACILIO_BASE_URL=https://app.facilio.co.ae/AccommodationManagement

# Facilio API key — sent to Facilio as the `x-api-key` header
FACILIO_API_KEY=

# ── Module names (vary by org / deployment) ─────────────────────────────────
# Only MODULE names live in env — they can differ across org clones (dev /
# sandbox / prod). Individual field link names are NOT here; they're defined in
# code (the IF map in server.mjs), since they don't change per environment.
FACILIO_INQUIRY_MODULE=custom_inquiries
FACILIO_TEMPLATE_MODULE=custom_questionnairetemplate
# Room-type lookup module — read by GET /room-types to populate the portal's
# room-type multi-select.
FACILIO_ROOMTYPE_MODULE=custom_roomtype
# Landing-page catalogs: service master + clusters (system zone module) +
# buildings (for per-cluster building count). Read by GET /services, GET /clusters.
FACILIO_SERVICES_MODULE=custom_services_1
FACILIO_CLUSTER_MODULE=zone
FACILIO_BUILDING_MODULE=building
# "Who is this for" — client-type enum on the standard Clients module.
# Read by GET /client-types (falls back to Company/Agency if meta can't be read).
FACILIO_CLIENT_MODULE=client
FACILIO_CLIENT_TYPE_FIELD=clienttype_client
